{
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "name": "Markdown Leader",
  "version": "0.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": ["file:///*"],
  "web_accessible_resources": [{
    "resources": ["assets/fonts/PretendardVariable.woff2", "assets/katex/*", "renderers/*"],
    "matches": ["file:///*"]
  }],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Markdown Leader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["content/startup.js"],
      "css": ["content/startup.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["file:///*"],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggleRefresh": {
      "description": "__MSG_shortcutToggleRefresh__",
      "suggested_key": { "default": "Alt+R" }
    },
    "togglePageTheme": {
      "description": "__MSG_shortcutToggleTheme__",
      "suggested_key": { "default": "Alt+T" }
    }
  }
}
